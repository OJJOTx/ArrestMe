# ArrestMe Environment Configuration Example
# Copy this file or set these variables in your CI/CD or local development environment.
# IMPORTANT: Never commit production credentials, secrets, or internal server keys here.

# Backend API Base URL for Android build
# Format: https://your-server-domain.com or http://10.0.2.2:3000 (emulator/local development)
# In GitHub Actions: configure repository variable ARRESTME_API_BASE_URL
# In local Gradle: set ARRESTME_API_BASE_URL in gradle.properties or pass via ORG_GRADLE_PROJECT_ARRESTME_API_BASE_URL
ARRESTME_API_BASE_URL=https://api.example.com
