# Example local gradle.properties configuration for ArrestMe Android
# Copy contents to gradle.properties or ~/.gradle/gradle.properties to test with a custom backend

# Public API Base URL for the ArrestMe backend (Hostinger Fastify or self-hosted)
# If left blank or omitted, the application operates in 100% Local-Only (Offline) mode.
ARRESTME_API_BASE_URL=https://api.example.com
